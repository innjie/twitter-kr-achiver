# =============================================================================
# 트위터 다국어 아카이빙 도구 - 환경 설정 예시
# 이 파일을 복사해 .env로 만들고 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env는 개인 설정/시크릿 파일이므로 절대 git에 커밋하지 마세요 (.gitignore에 이미 포함됨).
# =============================================================================

# ---------------------------------------------------------------------------
# 앱 실행 모드
# local  : 개인 PC에서만 실행, 외부 노출 없음
# server : 홈서버/VPS 등 외부에서 접속 가능한 환경 (Basic Auth 필수)
# ---------------------------------------------------------------------------
APP_MODE=local
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# [보안 필수] 서버 모드 Basic Auth (docs/06_개발가이드.md §9 #8)
# APP_MODE=server일 때 미설정 시 앱 실행이 차단됩니다.
# ---------------------------------------------------------------------------
APP_USERNAME=
APP_PASSWORD=

# ---------------------------------------------------------------------------
# DB 설정 (기본: SQLite / 선택: Postgres)
# ---------------------------------------------------------------------------
DB_TYPE=sqlite
# sqlite 예시: file:./data/archive.db
# postgres 예시: postgresql://user:password@127.0.0.1:5432/twitter_archive
DATABASE_URL=file:./data/archive.db

# ---------------------------------------------------------------------------
# 검색엔진 설정 (기본: Meilisearch / 선택: Elasticsearch)
# ---------------------------------------------------------------------------
SEARCH_ENGINE=meilisearch

# --- Meilisearch ---
MEILI_HOST=http://127.0.0.1:7700
# [보안 필수] 미설정 시 누구나 API로 전체 데이터 조회/수정 가능 (§9 #1)
# 생성 예시: openssl rand -base64 32
MEILI_MASTER_KEY=

# --- Elasticsearch (SEARCH_ENGINE=elasticsearch일 때만 사용) ---
ELASTIC_HOST=https://127.0.0.1:9200
ELASTIC_USERNAME=elastic
# [보안 필수] 미설정 시 인증 없이 9200 포트 접근 가능 (§9 #2)
# 최초 실행 시 elasticsearch-reset-password로 발급받은 값을 입력하세요.
ELASTIC_PASSWORD=

# ---------------------------------------------------------------------------
# [보안 필수] OAuth 토큰 암호화 키 (docs/06_개발가이드.md §9 #5)
# Refresh Token을 AES-256으로 암호화해 저장할 때 사용. 코드에 하드코딩 금지.
# 생성 예시: openssl rand -hex 32
# ---------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# X API (OAuth 2.0 + PKCE, BYOK - 각자 발급받은 값 사용)
# https://developer.x.com 에서 본인 명의 앱을 생성해 발급받으세요.
# ---------------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
