# 서버 프로필(docker-compose.server.yml) 리버스 프록시 설정.
# DOMAIN이 실제 공인 도메인이면 Caddy가 Let's Encrypt 인증서를 자동 발급/갱신한다
# (HTTP-01/TLS-ALPN 챌린지를 위해 80/443 포트가 인터넷에서 실제로 열려 있어야 함).
# DOMAIN 미설정 시 기본값 localhost로 동작하며, 이 경우 Caddy 내부 CA의 자체 서명
# 인증서를 사용한다 (Tailscale 등 사설 네트워크 전용 — 공인 브라우저에서는 경고가 뜨는 게 정상).
{$DOMAIN:localhost} {
	reverse_proxy backend:3000
}
